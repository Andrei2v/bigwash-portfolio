# Public frontend configuration for local development. No credentials belong here.
# Local authentication requires DEV && !PROD && VITE_LOCAL_MODE === 'true'.
VITE_LOCAL_MODE=true
VITE_DEMO_MODE=false

# Used only when local mode is disabled; production always uses the Go API.
# Set the deployed API/WS addresses before building for production.
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/api/v1/ws

# Optional public support link, e.g. https://t.me/<your_public_username>.
# Never put a Telegram bot token here. Leave empty until a recipient is agreed.
VITE_TELEGRAM_SUPPORT_URL=

# Create your own DEV account using the registration form at /login.
# Accounts belong to this browser and origin; this is not production security.
