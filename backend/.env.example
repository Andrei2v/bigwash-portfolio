# Copy to .env and replace with your own local values. Never commit .env.
DB_DSN=bigwash_user:REPLACE_WITH_LOCAL_PASSWORD@tcp(127.0.0.1:3306)/bigwash?charset=utf8mb4&parseTime=True&loc=Local
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=8080
# Dangerous test-data reset endpoint is DISABLED by default.
BIGWASH_ENABLE_DEBUG_SEED=false
# Development-only features; leave disabled outside a trusted local test environment.
BIGWASH_ENABLE_REGISTRATION=false
BIGWASH_ENABLE_WS=false
# Comma-separated exact Origin values. Add your deployed frontend origin when testing.
BIGWASH_ALLOWED_ORIGINS=http://localhost:5173
